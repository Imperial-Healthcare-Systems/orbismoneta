# OrbisMoneta — environment.
#
# Copy to .env.local for local development, and set the same names in the
# hosting dashboard for production (Vercel → Project → Settings → Environment
# Variables). NEVER commit a file with real values in it: .gitignore keeps
# .env.local and friends out, and this template deliberately holds no secrets.

# --------------------------------------------------------------- admin portal
# The password for /admin. Required — with this unset the portal refuses every
# login rather than falling back to a default, because a default in a public
# repository is not a password.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie and salts the visitor hash. If it is
# absent the signing key is derived from ADMIN_PASSWORD, which works fine; set
# it to any long random string to have the two be independent.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------ supabase
# Supabase → Project Settings → API.
#
# The URL is public and appears in the browser. The service role key is NOT:
# it bypasses every row level security policy in the database. It has no
# NEXT_PUBLIC_ prefix so Next cannot inline it into a client bundle, and
# lib/supabase.ts is marked server-only so an accidental client import fails
# the build instead of shipping it. Do not add the prefix.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, local only. Traction is not recorded while the site runs under
# `next dev`, because local development shares the same database as the live
# site and the client's figures should be their visitors, not your testing.
# Set this to 1 to count locally anyway.
TRACTION_COUNT_DEV=

# ------------------------------------------------------------------- mail
# Outbound SMTP for the enquiry forms. Without these the endpoint refuses the
# submission with a clear message rather than telling the visitor their
# enquiry was received when nothing was sent.
#
# Port 587 is submission-with-STARTTLS, which is what lib/mailer.ts assumes.
# 465 (implicit TLS) also works and is detected automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where enquiries land. Defaults to SMTP_USER when unset. One inbox for now —
# the form's "which team should see this?" answer leads the subject line
# instead of changing the address.
ENQUIRY_TO=
